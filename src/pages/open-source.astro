---
import Base from '../layouts/Base.astro'
import ProjectRow from '../components/ProjectRow.astro'
import { contributions } from '../data/open-source'
import { site } from '../data/site'
import { getStars, formatStars } from '../lib/github'

/* One entry per upstream repo, not per PR: three of the four patches landed
   in the same project, and the star count belongs to the project. */
const upstream = [...new Set(contributions.map((c) => c.repo))]
const stars = await getStars(upstream)
---

<Base
  title="Open source · Sachit Madaan"
  description="Patches by Sachit Madaan merged into projects maintained by other people, with what each one fixed."
  kind="collection"
  trail={[{ name: 'Open source', path: '/open-source' }]}
  collection={{
    items: contributions.map((c) => ({ name: c.repo, url: c.url })),
  }}
>
  <div class="column page">
    <h1>Open source</h1>
    <hr class="rule" />

    {
      contributions.length > 0 ? (
        <div class="rows">
          {contributions.map((c) => (
            <ProjectRow href={c.url} title={c.repo} summary={c.summary} tag={c.tag} newTab />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing merged upstream yet.</p>
      )
    }

    {
      stars.size > 0 && (
        <p class="stars mono">
          {upstream
            .filter((repo) => stars.has(repo))
            .map((repo, i) => (
              <>
                {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
                {formatStars(stars.get(repo)!)} stars on{' '}
                <a class="ext" href={`https://github.com/${repo}`} target="_blank" rel="noopener">
                  {repo}
                </a>
              </>
            ))}
        </p>
      )
    }

    <div class="notes">
      {
        contributions.map((c) => (
          <div class="note">
            <p class="meta mono">
              {c.tag} · merged {c.merged}
            </p>
            <p class="what">{c.description}</p>
          </div>
        ))
      }
    </div>

    <p class="tail mono">
      More at <a class="ext" href={site.github} rel="me noopener">github.com/{site.githubUser}</a>
    </p>
  </div>
</Base>

<style>
  .page {
    padding-top: 3.5rem;
  }

  .rule {
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .empty {
    color: var(--muted);
  }

  /* Read at build time, so it ages with the deploy rather than with the file.
     Absent entirely if GitHub cannot be reached. */
  .stars {
    color: var(--muted);
    margin-top: 1.25rem;
    text-wrap: pretty;
  }

  .stars .sep {
    color: color-mix(in srgb, var(--muted) 50%, var(--paper));
  }

  /* The row above states what changed; this states what was wrong. Keyed by
     PR number rather than by repeating the repo, which the row already names. */
  .notes {
    margin-top: 2.5rem;
  }

  .note {
    max-width: 38rem;
  }

  .note + .note {
    margin-top: 1.75rem;
  }

  /* Full --muted, like the footer strip: anything lighter drops under 4.5:1. */
  .meta {
    color: var(--muted);
  }

  .what {
    color: var(--muted);
    margin-top: 0.35rem;
    text-wrap: pretty;
  }

  .tail {
    margin-top: 2.5rem;
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .page {
      padding-top: 2.5rem;
    }
  }
</style>
