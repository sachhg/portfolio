---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import Entry from '../../layouts/Entry.astro'

export async function getStaticPaths() {
  const posts = (await getCollection('writing')).filter((p) => !p.data.draft)
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }))
}

interface Props {
  entry: CollectionEntry<'writing'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
const d = entry.data

const display = d.date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})

// Counted off the raw MDX, minus frontmatter and any JSX, so timeRequired in
// the structured data reflects the prose rather than the markup.
const wordCount = entry.body!
  .replace(/^---[\s\S]*?---/, '')
  .replace(/<[^>]+>/g, ' ')
  .replace(/```[\s\S]*?```/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length
---

<Entry
  title={d.title}
  description={d.description}
  meta={[display]}
  datetime={d.date.toISOString()}
  ogType="article"
  kind="article"
  trail={[
    { name: 'Writing', path: '/writing' },
    { name: d.title, path: `/writing/${entry.id}` },
  ]}
  article={{ date: d.date, wordCount, section: 'Engineering' }}
  transitionName={`t-${entry.id}`}
  back={{ href: '/writing', label: 'All writing' }}
>
  <Content />
</Entry>
