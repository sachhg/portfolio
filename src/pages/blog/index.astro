---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PostRow from '../../components/PostRow.astro'

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
---

<Base
  title="Blog · Sachit Madaan"
  description="Notes on distributed systems, databases, program analysis, and machine learning infrastructure by Sachit Madaan."
  kind="collection"
  trail={[{ name: 'Blog', path: '/blog' }]}
  collection={{
    items: posts.map((p) => ({
      name: p.data.title,
      url: new URL(`/blog/${p.id}`, Astro.site).href,
    })),
  }}
>
  <div class="column page">
    <h1>Blog</h1>
    <p class="lede">Notes on things I&rsquo;ve had to think hard about.</p>

    <hr class="rule" />

    {
      posts.length > 0 ? (
        <div class="rows">
          {posts.map((p) => (
            <PostRow
              href={`/blog/${p.id}`}
              title={p.data.title}
              date={p.data.date}
              transitionName={`t-${p.id}`}
            />
          ))}
        </div>
      ) : (
        <p class="empty">Nothing published yet.</p>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-top: 3.5rem;
  }

  .lede {
    color: var(--muted);
    margin-top: 0.4rem;
    max-width: 34rem;
    text-wrap: pretty;
  }

  .rule {
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .empty {
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    .page {
      padding-top: 2.5rem;
    }
  }
</style>
