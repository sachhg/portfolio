---
import { Image } from 'astro:assets'
import type { BookSeries } from '../data/books'

interface Props { series: BookSeries }
const { series } = Astro.props
---

<details class="series">
  <summary aria-label={`Explore ${series.title} series`}>
    <div class="cover-stack" aria-hidden="true">
      {series.volumes.slice(0, 3).reverse().map((volume, index, stack) => (
        <Image src={volume.cover} data-depth={stack.length - index - 1} alt="" widths={[240, 480]} width={480} sizes="(max-width: 600px) 40vw, 200px" format="webp" loading="lazy" />
      ))}
    </div>
    <div class="series-title">
      <h3>{series.title}{series.favorite && <span class="favorite-star" role="img" aria-label="Favorite read" title="A favorite read">★</span>}</h3>
      <p class="author">{series.author}</p>
      <span class="series-toggle mono"><span class="closed-label">Explore series</span><span class="open-label">Close series</span><span class="toggle-icon" aria-hidden="true">+</span></span>
    </div>
  </summary>
  <div class="series-shelf">
    <ul>
      {series.volumes.map((volume) => (
        <li>
          <div class="volume-cover">
            <Image src={volume.cover} alt={`Cover of ${volume.title}`} widths={[240, 480]} width={480} sizes="(max-width: 600px) 40vw, 170px" format="webp" loading="lazy" />
          </div>
          <h4>{volume.title}</h4>
        </li>
      ))}
    </ul>
  </div>
</details>

<style>
  summary { list-style: none; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .cover-stack { position: relative; aspect-ratio: 2 / 3; margin-bottom: 1.1rem; isolation: isolate; }
  .cover-stack img {
    position: absolute;
    width: calc(100% - 12px);
    height: calc(100% - 12px);
    bottom: 0;
    left: 0;
    object-fit: contain;
    object-position: left bottom;
    border-radius: 1px 3px 3px 1px;
    box-shadow: 2px 4px 9px rgb(40 32 18 / 16%);
    transform-origin: bottom left;
    transition: transform 250ms var(--ease-out);
  }
  .cover-stack img[data-depth='2'] { transform: translate(12px, -12px); }
  .cover-stack img[data-depth='1'] { transform: translate(6px, -6px); }
  h3 { font-size: 1.2rem; line-height: 1.25; text-wrap: pretty; }
  .favorite-star { display: inline-block; color: var(--accent); font-size: 0.75rem; margin-left: 0.45rem; vertical-align: 0.12em; }
  .author { color: var(--muted); font-size: 0.95rem; line-height: 1.4; margin-top: 0.4rem; }
  .series-toggle { display: flex; align-items: center; gap: 0.8rem; color: var(--accent); margin-top: 0.75rem; font-size: 0.65rem; }
  .toggle-icon { font-size: 1rem; line-height: 1; transition: transform 200ms var(--ease-out); }
  .open-label { display: none; }
  .series[open] { border-block: 1px solid var(--line); padding-block: 1.5rem 2rem; }
  .series[open] summary { display: flex; align-items: center; gap: 1.5rem; width: fit-content; }
  .series[open] .cover-stack { width: 70px; flex-shrink: 0; margin: 0; }
  .series[open] .open-label { display: inline; }
  .series[open] .closed-label { display: none; }
  .series[open] .toggle-icon { transform: rotate(45deg); }
  .series-shelf { margin-top: 2rem; }
  .series-shelf ul { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 2rem 1.75rem; }
  .volume-cover { aspect-ratio: 2 / 3; margin-bottom: 0.8rem; }
  .volume-cover img { width: 100%; height: 100%; object-fit: contain; border-radius: 2px; box-shadow: 2px 4px 9px rgb(40 32 18 / 14%); }
  h4 { font-family: var(--serif); font-size: 1.05rem; font-weight: 400; line-height: 1.3; margin: 0; text-wrap: pretty; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .series:not([open]) summary:hover .cover-stack img[data-depth='2'],
    .series:not([open]) summary:focus-visible .cover-stack img[data-depth='2'] { transform: translate(12px, -12px) rotate(5deg); }
    .series:not([open]) summary:hover .cover-stack img[data-depth='1'],
    .series:not([open]) summary:focus-visible .cover-stack img[data-depth='1'] { transform: translate(6px, -6px) rotate(2.5deg); }
  }
  @media (max-width: 850px) { .series-shelf ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    h3 { font-size: 1.12rem; }
    .author { font-size: 0.9rem; }
    .series-shelf ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1.5rem; }
    h4 { font-size: 1rem; }
  }
</style>
