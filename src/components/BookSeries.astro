---
import { Image } from 'astro:assets'
import type { BookSeries } from '../data/books'

interface Props { series: BookSeries }
const { series } = Astro.props
---

<article class="series">
  <div class="cover-stack">
    {series.volumes.slice(0, 3).reverse().map((volume, index, stack) => (
      <Image src={volume.cover} data-depth={stack.length - index - 1} alt={index === stack.length - 1 ? `Cover of ${volume.title}, from ${series.title}` : ''} widths={[240, 480]} width={480} sizes="(max-width: 600px) 40vw, (max-width: 850px) 25vw, 200px" format="webp" loading="lazy" />
    ))}
    {series.favorite && <span class="favorite-ribbon" role="img" aria-label="Favorite read" title="A favorite read">★</span>}
  </div>
  <h3>{series.title}</h3>
  <p class="author">{series.author}</p>
</article>

<style>
  .cover-stack { position: relative; aspect-ratio: 2 / 3; margin-bottom: 1.1rem; isolation: isolate; }
  .cover-stack img {
    position: absolute;
    width: calc(100% - 12px);
    height: calc(100% - 12px);
    bottom: 0;
    left: 0;
    object-fit: contain;
    object-position: left bottom;
    border-radius: 1px 3px 3px 1px;
    box-shadow: 2px 4px 9px rgb(40 32 18 / 16%);
    transform-origin: bottom left;
    transition: transform 250ms var(--ease-out);
  }
  .cover-stack img[data-depth='2'] { transform: translate(12px, -12px); }
  .cover-stack img[data-depth='1'] { transform: translate(6px, -6px); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .series:hover .cover-stack img[data-depth='2'] {
      transform: translate(12px, -12px) rotate(5deg);
    }
    .series:hover .cover-stack img[data-depth='1'] {
      transform: translate(6px, -6px) rotate(2.5deg);
    }
  }
  h3 { font-size: 1.2rem; line-height: 1.25; text-wrap: pretty; }
  .author { color: var(--muted); font-size: 0.95rem; line-height: 1.4; margin-top: 0.4rem; }
  .favorite-ribbon {
    position: absolute;
    top: 9px;
    right: 24px;
    width: 27px;
    height: 38px;
    padding-top: 5px;
    text-align: center;
    background: var(--accent);
    color: var(--paper);
    font-size: 14px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
  }
  @media (max-width: 600px) {
    h3 { font-size: 1.12rem; }
    .author { font-size: 0.9rem; }
  }
</style>
