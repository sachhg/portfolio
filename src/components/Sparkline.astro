---
/**
 * 100×14 commit sparkline. Pure inline SVG, no script, no fill — it should
 * read as a piece of punctuation in the footer line, not a chart.
 */
interface Props {
  values: number[]
  width?: number
  height?: number
}

const { values, width = 100, height = 14 } = Astro.props

const PAD = 1.5
const max = Math.max(...values, 1)
const span = values.length - 1

const points = values.map((v, i) => {
  const x = span === 0 ? 0 : (i / span) * (width - PAD * 2) + PAD
  const y = height - PAD - (v / max) * (height - PAD * 2)
  return `${x.toFixed(1)},${y.toFixed(1)}`
})

const total = values.reduce((a, b) => a + b, 0)
---

<svg
  class="spark"
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  role="img"
  aria-label={`${total} commits over the last ${values.length} days`}
  preserveAspectRatio="none"
  fill="none"
>
  <polyline
    points={points.join(' ')}
    stroke="var(--muted)"
    stroke-width="1"
    stroke-linejoin="round"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  ></polyline>
</svg>

<style>
  .spark {
    display: inline-block;
    vertical-align: -2px;
    opacity: 0.55;
    /* Never let the sparkline force the footer line to wrap awkwardly. */
    flex: 0 0 auto;
  }
</style>
