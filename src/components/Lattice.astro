---
/**
 * Drifting lattice, the one piece of motion on the site.
 *
 * A sparse, slightly-perturbed point lattice drifting across the page over
 * minutes. Every 6-10s a few neighboring points briefly connect, a nod to
 * lattice-based cryptography (see pqc-scan).
 *
 * The perturbation is seeded from today's date, so the arrangement is fixed
 * for a day and different tomorrow.
 *
 * Sits behind all content at low opacity and never affects text contrast.
 */
---

<canvas id="lattice" aria-hidden="true"></canvas>

<style>
  #lattice {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('lattice') as HTMLCanvasElement | null
  const ctx = canvas?.getContext('2d')

  if (canvas && ctx) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)')

    // Deterministic within a day, different the next.
    const mulberry32 = (a: number) => () => {
      a = (a + 0x6d2b79f5) | 0
      let t = Math.imul(a ^ (a >>> 15), 1 | a)
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296
    }

    const style = getComputedStyle(document.documentElement)
    const muted = style.getPropertyValue('--muted').trim() || '#6E6A5E'
    const accent = style.getPropertyValue('--accent').trim() || '#2F4A8A'

    const TARGET_POINTS = 55
    const DOT_ALPHA = 0.22
    const LINK_ALPHA = 0.2
    const LINK_LIFE = 2600 // ms, fade in and out
    const DRIFT_X = 3.4 // px/s, so a full traversal takes minutes
    const DRIFT_Y = 1.2

    interface Point { gx: number; gy: number; px: number; py: number; ph: number; am: number }
    interface Link { a: number; b: number; born: number }

    let pts: Point[] = []
    let links: Link[] = []
    let spacing = 160
    let fieldW = 0
    let fieldH = 0
    let w = 0
    let h = 0
    let nextLink = 0
    let raf = 0
    let last = 0
    let t = 0 // seconds of accumulated animation time

    function build() {
      const dpr = Math.min(devicePixelRatio || 1, 2)
      w = innerWidth
      h = innerHeight
      canvas!.width = Math.round(w * dpr)
      canvas!.height = Math.round(h * dpr)
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0)

      // Spacing adapts so point count stays in the intended band on any screen.
      spacing = Math.max(110, Math.sqrt((w * h) / TARGET_POINTS))

      const d = new Date()
      const seed =
        d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate()
      const rnd = mulberry32(seed)

      const cols = Math.ceil(w / spacing) + 2
      const rows = Math.ceil(h / spacing) + 2
      fieldW = cols * spacing
      fieldH = rows * spacing

      pts = []
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          pts.push({
            gx: x * spacing,
            gy: y * spacing,
            // Perturbation: up to ±14% of a cell. Enough to break the ruled
            // grid, little enough that the lattice still reads as one.
            px: (rnd() - 0.5) * spacing * 0.28,
            py: (rnd() - 0.5) * spacing * 0.28,
            ph: rnd() * Math.PI * 2,
            am: 2 + rnd() * 3,
          })
        }
      }

      links = []
      nextLink = t + 2 + rnd() * 3
    }

    const wrap = (v: number, m: number) => ((v % m) + m) % m

    function posOf(p: Point) {
      return {
        x: wrap(p.gx + p.px + DRIFT_X * t, fieldW) - spacing +
           Math.sin(t * 0.06 + p.ph) * p.am,
        y: wrap(p.gy + p.py + DRIFT_Y * t, fieldH) - spacing +
           Math.cos(t * 0.05 + p.ph) * p.am,
      }
    }

    /** Connect one point to its 2-3 nearest neighbors. */
    function spawnLinks() {
      if (pts.length < 4) return
      const i = Math.floor(Math.random() * pts.length)
      const a = posOf(pts[i]!)
      const maxD = spacing * 1.5

      const near = pts
        .map((p, j) => {
          const q = posOf(p)
          return { j, d: Math.hypot(q.x - a.x, q.y - a.y) }
        })
        .filter((n) => n.j !== i && n.d < maxD)
        .sort((m, n) => m.d - n.d)
        .slice(0, 2 + Math.floor(Math.random() * 2))

      for (const n of near) links.push({ a: i, b: n.j, born: t })
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h)

      ctx!.fillStyle = muted
      ctx!.globalAlpha = DOT_ALPHA
      for (const p of pts) {
        const { x, y } = posOf(p)
        ctx!.beginPath()
        ctx!.arc(x, y, 1.2, 0, Math.PI * 2)
        ctx!.fill()
      }

      ctx!.strokeStyle = accent
      ctx!.lineWidth = 1
      for (const l of links) {
        const age = (t - l.born) * 1000
        if (age > LINK_LIFE) continue
        // Fade in and back out; never a hard on/off.
        ctx!.globalAlpha = Math.sin((age / LINK_LIFE) * Math.PI) * LINK_ALPHA
        const a = posOf(pts[l.a]!)
        const b = posOf(pts[l.b]!)
        // Skip a pair that wrapped to opposite edges this frame.
        if (Math.hypot(b.x - a.x, b.y - a.y) > spacing * 2) continue
        ctx!.beginPath()
        ctx!.moveTo(a.x, a.y)
        ctx!.lineTo(b.x, b.y)
        ctx!.stroke()
      }

      ctx!.globalAlpha = 1
    }

    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.1) // clamp after a tab stall
      last = now
      t += dt

      if (t >= nextLink) {
        spawnLinks()
        nextLink = t + 6 + Math.random() * 4
      }
      if (links.length > 24) links = links.filter((l) => (t - l.born) * 1000 <= LINK_LIFE)

      draw()
      raf = requestAnimationFrame(frame)
    }

    function start() {
      if (raf || reduced.matches) return
      last = performance.now()
      raf = requestAnimationFrame(frame)
    }

    function stop() {
      cancelAnimationFrame(raf)
      raf = 0
    }

    function reset() {
      build()
      draw() // a correct static frame before any animation begins
      if (reduced.matches) stop()
      else if (!document.hidden) start()
    }

    let resizeTimer: ReturnType<typeof setTimeout>
    addEventListener('resize', () => {
      clearTimeout(resizeTimer)
      resizeTimer = setTimeout(reset, 150)
    })

    // Idle tabs cost nothing.
    document.addEventListener('visibilitychange', () =>
      document.hidden ? stop() : start()
    )

    reduced.addEventListener('change', reset)

    reset()
  }
</script>
